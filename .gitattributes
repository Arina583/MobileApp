# Нормализация окончаний для текстовых файлов
* text=auto

# Kotlin, Gradle, XML, JSON, TOML — всегда LF
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.properties text eol=lf

# .gitignore и прочие конфиги — тоже LF
.gitignore text eol=lf
.gitattributes text eol=lf

# Бинарные файлы — без конвертации
*.png binary
*.jpg binary
*.jar binary
*.aar binary
